{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projectType": "application",
  "cli": {
    "schematicExtensions": {}
  },
  "defaults": {
    "styleExtensions": [
      "scss",
      "css"
    ]
  },
  "project": {
    "name": "contizador-venta-inmobiliaria",
    "architect": {
      "build": {
        "builder": "@angular-devkit/build-angular:browser",
        "options": {
          "outputPath": "dist/",
          "index": "src/index.html",
          "main": "src/main.ts",
          "polyfills": [
            "zone.js"
          ],
          "favicon": "src/assets/favicon.ico",
          "styles": [
            "src/styles.css"
          ],
          "scripts": []
        }
      },
      "serve": {
        "builder": "@angular-devkit/build-angular:devserver",
        "options": {
          "browserTarget": "contizador-venta-inmobiliaria:build"
        }
      },
      "extract-i18n": {
        "builder": "@angular-devkit/build-angular:extract-i18n",
        "options": {
          "batch": "ian"
        }
      },
      "test": {
        "builder": "@angular-devkit/build-angular:karma",
        "options": {
          "karmaConfig": "karma.conf.js",
          "tsConfig": "tsconfig.spec.json"
        }
      },
      "lint": {
        "builder": "@angular-devkit/build-angular:nglint",
        "options": {
          "project": "contizador-venta-inmobiliaria"
        }
      }
    }
  }
}